# LMS is the only identity source for Professor IT cards.
AUTH_MODE=professorit
PROFESSORIT_LMS_BASE_URL=https://academy.professorit.ru
PROFESSORIT_OAUTH_CLIENT_ID=replace-with-frappe-oauth-client-id
PROFESSORIT_OAUTH_CLIENT_SECRET=store-only-in-a-closed-env-file
PROFESSORIT_APP_BASE_URL=https://professorit.ru/cards
PROFESSORIT_OAUTH_CALLBACK_URL=https://professorit.ru/cards/v1/auth/callback
PROFESSORIT_COOKIE_PATH=/cards
PROFESSORIT_SESSION_SECRET=generate-a-long-random-secret
BACKEND_ALLOWED_ORIGINS=https://professorit.ru
PUBLIC_APP_BASE_URL=https://professorit.ru
VITE_PUBLIC_BASE_PATH=/cards/
